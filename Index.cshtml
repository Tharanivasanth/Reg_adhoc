@model List<Registration.Models.Reg>




<a asp-action="Create">Add New</a>
<h2> Registeration details/h2>
<table border="1" cellpadding="3">
    <tr>
        <th>Name</th>
        <th>Qualification</th>
        <th>Age</th>
        <th>Mobile</th>
        <th>Email</th>
    </tr>
    @foreach(var dept in Model)
    {
        <tr>
            <td>@dept.Name</td>
            <td>@dept.Qualification</td>
                <td>@dept.Age</td>
                <td>@dept.Mobile</td>
                <td>@dept.Email</td>


            <td><a asp-action="Edit" asp-route-deptID="@dept.Id">Edit</a>
              <a href="#" onclick="confirmDelete(@dept.Id); return false;">Delete</a>

                <form id="deleteForm-@dept.Id" asp-action="Delete" asp-route-deptID="@dept.Id" method="post" style="display:none;"></form>
            </td>
        </tr>
    }
</table>
<script>
    function confirmDelete(Id) {
        if (confirm('Are you sure you want to delete this employee?')) {
            document.getElementById('deleteForm-' + Id).submit();
        }
    }
</script>

