    <div>
    <lable> Name</lable>
    <input type="Text"name="Name" value="@Model.Name"/>
</div></<br />
    <lable> Qualification</lable>
    <input type="Text" name="Qualification" value="@Model.Qualification" />
    </div></<br />
    <lable> Age</lable>
    <input type="Text" name="Age" value="@Model.Age" />
    </div></<br />
